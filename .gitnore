# ── Database (NEVER commit — this is live customer data) ─────────────────
# Committing the DB means `git reset --hard` on the server wipes real
# bookings/finances back to the committed copy on every deploy.
bookings.db
bookings.db-wal
bookings.db-shm
*.db
*.db-wal
*.db-shm

# Backups created by deploy.sh
backups/

# Flask session secret (machine-specific; committing it breaks/leaks sessions)
.flask_secret

# Python
venv/
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Env files (may hold ADMIN_PASSWORD, PUSHOVER tokens, etc.)
.env
.env.*