# ── Kaiser's Detail Co. — files that must NEVER be committed ──────────────
# The live database lives only on the server. If it gets committed, every
# `git reset --hard` on deploy overwrites real bookings with an old snapshot
# (this is what caused deleted bookings to reappear after each deploy).
bookings.db
bookings.db-wal
bookings.db-shm
bookings.db-journal
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Server-side session secret — generated per machine, must stay local.
.flask_secret

# Python cruft
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Logs
*.log